{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing account settings and role",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "username": {
          "type": "string",
          "description": "Display username",
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "enum": ["USER", "ADMIN"],
          "description": "Role permission level"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "email", "username", "role", "createdAt"]
    },
    "ServerRecord": {
      "title": "ServerRecord",
      "description": "Minecraft server cloud registration",
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "software": {
          "type": "string",
          "maxLength": 50
        },
        "version": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "maxLength": 30
        },
        "subdomain": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["serverId", "userId", "name", "software", "version", "status", "subdomain", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile and access levels"
    },
    "/servers/{serverId}": {
      "schema": {
        "$ref": "#/entities/ServerRecord"
      },
      "description": "Stores synced cloud Minecraft server records"
    }
  }
}
