rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'infbuisness01@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'username', 'role', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'email', 'username', 'role', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.username is string && data.username.size() <= 64 &&
        data.role in ['USER', 'ADMIN'] &&
        data.createdAt is string;
    }

    function isValidServerRecord(data) {
      return data.keys().hasAll(['serverId', 'userId', 'name', 'software', 'version', 'status', 'subdomain', 'createdAt']) &&
        data.keys().hasOnly(['serverId', 'userId', 'name', 'software', 'version', 'status', 'subdomain', 'createdAt', 'updatedAt', 'ramMb', 'port']) &&
        data.serverId is string && data.serverId.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() <= 100 &&
        data.software is string && data.software.size() <= 50 &&
        data.version is string && data.version.size() <= 20 &&
        data.status is string && data.status.size() <= 30 &&
        data.subdomain is string && data.subdomain.size() <= 120 &&
        data.createdAt is string;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Servers Collection
    match /servers/{serverId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(serverId) && isValidServerRecord(request.resource.data);
      allow update: if isSignedIn() && isValidId(serverId) && (resource.data.userId == request.auth.uid || isAdmin()) &&
        isValidServerRecord(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.serverId == resource.data.serverId &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && isValidId(serverId) && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
