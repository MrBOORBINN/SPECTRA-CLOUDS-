# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Database & Authentication Secrets
DATABASE_URL="postgresql://infhost_user:password@localhost:5432/infhost?schema=public"
JWT_SECRET="your-ultra-secure-jwt-secret-min-32-chars-hex"
SESSION_SECRET="your-session-encryption-secret-key-infhost"

# Node Controller Security
NODE_API_SECRET="infhost-node-cluster-master-secret-key"

# External Integrations (Keep configurable, graceful fallback when unconfigured)
DNS_API_KEY="cloudflare_or_route53_api_key_placeholder"
DNS_ZONE_ID="infhost.net_zone_id"
PAYMENT_API_KEY="rzp_test_or_stripe_api_key_placeholder"
PAYMENT_WEBHOOK_SECRET="payment_webhook_secret_key"
AD_PROVIDER_KEY="rewarded_ads_partner_api_key"

# Environment Mode
DEVELOPMENT_MODE="true"
PRODUCTION_MODE="false"
PORT="3000"
